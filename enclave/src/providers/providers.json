{
  "version": 1,
  "providers": [
    {
      "id": "example",
      "adapter": "openai_v1",
      "baseUrl": "https://api.example.com/v1",
      "apiKeyEnvVar": "EXAMPLE_API_KEY",
      "models": [
        {
          "id": "sample-chat-model",
          "displayName": "Sample Chat Model",
          "contextWindow": 128000,
          "capabilities": {
            "strengths": [
              "general_reasoning"
            ],
            "modalities": [
              "text_in",
              "text_out"
            ],
            "endpointFamily": "chat",
            "costTier": "medium",
            "latencyTier": "standard",
            "routingStatus": "enabled",
            "requiredGatewayTools": []
          }
        }
      ],
      "customModel": {
        "enabled": false
      }
    }
  ],
  "signature": "SAMPLE-NOT-A-VALID-SIGNATURE"
}
