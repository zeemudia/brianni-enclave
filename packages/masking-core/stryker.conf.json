{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Pattern 5 mutation run over the masking-core de-identification logic — the sole on-device PII masking surface (architecture invariant). Pure package, hermetic tests. Non-blocking (thresholds.break=null). See docs/quality/mutation-testing.md.",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.ts" },
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/types.ts",
    "!src/stylometric/index.ts",
    "!src/stylometric/types.ts",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/masking-core.html" },
  "jsonReporter": { "fileName": "reports/mutation/masking-core.json" },
  "thresholds": { "high": 85, "low": 70, "break": null },
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp"
}
