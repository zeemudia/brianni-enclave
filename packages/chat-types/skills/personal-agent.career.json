{
  "id": "personal-agent.career",
  "version": 1,
  "displayName": "Career & salary",
  "description": "Job search, offer negotiation, salary research. Drop offer letters into a linked folder; the agent will read them.",
  "toolScopes": [
    "memory.list",
    "memory.read",
    "memory.write",
    "file.read",
    "folder.list",
    "folder.read",
    "folder.write",
    "email.draft",
    "doc.draft"
  ],
  "capabilitySuiteIds": [
    "text",
    "office-document",
    "pdf",
    "rtf",
    "apple-iwork",
    "google-stub"
  ],
  "defaultNamespace": "work",
  "linkedFolderScopes": {
    "allowedExtensions": [
      ".pdf",
      ".docx",
      ".rtf",
      ".txt",
      ".md"
    ],
    "defaultLabel": "Career"
  },
  "uiHints": {
    "icon": "briefcase",
    "accentToken": "accent-blue"
  }
}
