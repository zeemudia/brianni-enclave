{
  "id": "personal-agent.legal-tenant",
  "version": 1,
  "displayName": "Legal & tenancy",
  "description": "Everyday legal and tenancy questions — contracts, notices, deposits, consumer rights. Drop agreements or letters into a linked folder; the agent will read them. General information only, not legal advice.",
  "toolScopes": [
    "memory.list",
    "memory.read",
    "memory.write",
    "file.read",
    "folder.list",
    "folder.read",
    "folder.write",
    "email.draft",
    "doc.draft",
    "web.fetch"
  ],
  "capabilitySuiteIds": [
    "text",
    "office-document",
    "pdf",
    "rtf",
    "apple-iwork",
    "google-stub"
  ],
  "defaultNamespace": "default",
  "linkedFolderScopes": {
    "allowedExtensions": [
      ".pdf",
      ".docx",
      ".rtf",
      ".txt",
      ".md"
    ],
    "defaultLabel": "Legal"
  },
  "uiHints": {
    "icon": "home",
    "accentToken": "accent-amber"
  }
}
