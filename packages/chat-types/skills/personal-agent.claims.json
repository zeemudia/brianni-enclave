{
  "id": "personal-agent.claims",
  "version": 1,
  "displayName": "Claims advocate",
  "description": "Turn your documents into a dispute, appeal, or claim letter that recovers money or asserts a right. With your per-task consent, reads across the packs you authorise. Reads only what you select — never sends anything. You review and send the draft.",
  "toolScopes": [
    "memory.list",
    "memory.read",
    "file.read",
    "folder.list",
    "folder.read",
    "doc.draft",
    "research.ask"
  ],
  "capabilitySuiteIds": [
    "text",
    "office-document",
    "pdf"
  ],
  "defaultNamespace": "default",
  "crossPackNamespaces": [
    "default",
    "work",
    "money",
    "health"
  ],
  "linkedFolderScopes": {
    "allowedExtensions": [
      ".pdf",
      ".docx",
      ".txt",
      ".md"
    ],
    "defaultLabel": "Claims"
  },
  "uiHints": {
    "icon": "cash",
    "accentToken": "accent-default"
  }
}
