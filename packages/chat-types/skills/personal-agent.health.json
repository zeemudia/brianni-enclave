{
  "id": "personal-agent.health",
  "version": 1,
  "displayName": "Health & wellness",
  "description": "Understand health information, results, and letters, or prepare for an appointment. Drop reports into a linked folder; the agent will read them. General information only, not medical advice. Saved details use the consent-gated Health profile.",
  "toolScopes": [
    "memory.list",
    "memory.read",
    "memory.write",
    "file.read",
    "folder.list",
    "folder.read",
    "doc.draft",
    "web.fetch"
  ],
  "capabilitySuiteIds": [
    "text",
    "office-document",
    "pdf"
  ],
  "defaultNamespace": "health",
  "linkedFolderScopes": {
    "allowedExtensions": [
      ".pdf",
      ".docx",
      ".txt",
      ".md"
    ],
    "defaultLabel": "Health"
  },
  "uiHints": {
    "icon": "heart",
    "accentToken": "accent-default"
  }
}
